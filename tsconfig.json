{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "mcp-server/src/**/*.mjs",
    "tests/**/*.mjs",
    "scripts/**/*.mjs"
  ],
  "exclude": [
    "**/node_modules",
    "**/_reference-*"
  ]
}
